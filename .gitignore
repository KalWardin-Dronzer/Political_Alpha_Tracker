# Data files (cached, never source-controlled).
# graph.json is DERIVED from cache.sqlite via GraphManager.build_from_cache().
# It MUST stay untracked: the pipeline rewrites it on every run, and while it was
# tracked the dirty worktree made `git pull` fail on EC2, silently aborting deploys.
data/graph.json
data/cache.sqlite
data/cache.sqlite-wal
data/cache.sqlite-shm
data/pipeline.log
data/refresh.log
data/nse_industry_mapping.csv
data/held_positions.csv
# Derived price panel for the factor engine. Rebuildable in ~4 min via
# `python build_price_panel.py`, and large — never commit it.
data/prices/
data/pdfs/
data/cron.log

# Keep these tracked
!data/.gitkeep
data/political_alpha_cache.db
